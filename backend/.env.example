# ===========================================
# BACKEND — LOKAL development namunasi
# ===========================================
# Bu faylni backend/.env nomiga nusxalang (gitga kirmaydi)
#
# cp .env.example .env

DJANGO_SECRET_KEY=local-dev-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Lokal SQLite (default — fayl gitga kirmaydi)
# DATABASE_URL=

# Birinchi marta: python manage.py reset_minimal
SEED_DATABASE=false
