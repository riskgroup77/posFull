# ===========================================
# BACKEND — PRODUCTION server namunasi
# ===========================================
# Serverda: cp .env.production.example .env
# Domen: https://posapi.devflix.uz

DJANGO_SECRET_KEY=CHANGE-ME-strong-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=posapi.devflix.uz,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://pos.devflix.uz
CSRF_TRUSTED_ORIGINS=https://pos.devflix.uz,https://posapi.devflix.uz

# PostgreSQL (majburiy productionda)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/pos

# false bo'lishi kerak — har deployda ma'lumot o'chmasin!
SEED_DATABASE=false
